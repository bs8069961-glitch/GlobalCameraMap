@app.delete("/api/cameras/{camera_id}")
def delete_camera(camera_id: int):

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                DELETE FROM cameras
                WHERE id = %s
                RETURNING id
                """,
                (camera_id,),
            )

            deleted = cursor.fetchone()

        if not deleted:
            connection.rollback()

            raise HTTPException(
                status_code=404,
                detail="Camera not found",
            )

        connection.commit()

        return {
            "success": True,
            "deleted_id": deleted["id"],
        }

    except HTTPException:
        raise

    except Exception as exc:
        if connection:
            connection.rollback()

        logger.error("Failed to delete camera %s: %s", camera_id, exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to delete camera",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# CAMERA STATISTICS
# ============================================================

@app.get("/api/cameras/stats")
def camera_statistics():

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                SELECT COUNT(*) AS total
                FROM cameras
                """
            )
            total = cursor.fetchone()["total"]

            cursor.execute(
                """
                SELECT COUNT(*) AS active
                FROM cameras
                WHERE LOWER(status) = 'active'
                """
            )
            active = cursor.fetchone()["active"]

            cursor.execute(
                """
                SELECT COUNT(*) AS verified
                FROM cameras
                WHERE LOWER(verification_status) = 'verified'
                """
            )
            verified = cursor.fetchone()["verified"]

            cursor.execute(
                """
                SELECT COUNT(*) AS pending
                FROM cameras
                WHERE LOWER(verification_status) = 'pending'
                """
            )
            pending = cursor.fetchone()["pending"]

            cursor.execute(
                """
                SELECT
                    COALESCE(state, 'Unknown') AS state,
                    COUNT(*) AS count
                FROM cameras
                GROUP BY state
                ORDER BY count DESC
                """
            )
            by_state = cursor.fetchall()

            cursor.execute(
                """
                SELECT
                    COALESCE(camera_type, 'Unknown') AS camera_type,
                    COUNT(*) AS count
                FROM cameras
                GROUP BY camera_type
                ORDER BY count DESC
                """
            )
            by_type = cursor.fetchall()

        return {
            "total": total,
            "active": active,
            "verified": verified,
            "pending": pending,
            "by_state": by_state,
            "by_camera_type": by_type,
        }

    except Exception as exc:
        logger.error("Failed to retrieve statistics: %s", exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve camera statistics",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# REPORTS TABLE INITIALIZATION
# ============================================================

def ensure_reports_table():
    """
    Create the reports table if it does not already exist.

    This keeps the API compatible with the frontend's
    /api/reports/pending request.
    """

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor() as cursor:

            cursor.execute(
                """
                CREATE TABLE IF NOT EXISTS camera_reports (
                    id SERIAL PRIMARY KEY,

                    latitude DOUBLE PRECISION NOT NULL,
                    longitude DOUBLE PRECISION NOT NULL,

                    city VARCHAR(255),
                    state VARCHAR(255),
                    road_name VARCHAR(500),

                    camera_type VARCHAR(255),
                    description TEXT,

                    source VARCHAR(500),
                    source_url TEXT,

                    status VARCHAR(50) DEFAULT 'pending',

                    created_at TIMESTAMP DEFAULT NOW(),
                    updated_at TIMESTAMP DEFAULT NOW()
                )
                """
            )

        connection.commit()

        logger.info("Reports table checked successfully")

    except Exception as exc:
        if connection:
            connection.rollback()

        logger.warning(
            "Could not initialize reports table: %s",
            exc,
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# REPORT A CAMERA
# ============================================================

@app.post("/api/reports")
def report_camera(report: CameraReport):

    connection = None

    try:
        connection = get_db_connection()

        ensure_reports_table()

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                INSERT INTO camera_reports (
                    latitude,
                    longitude,
                    city,
                    state,
                    road_name,
                    camera_type,
                    description,
                    source,
                    source_url,
                    status
                )
                VALUES (
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    'pending'
                )
                RETURNING *
                """,
                (
                    report.latitude,
                    report.longitude,
                    report.city,
                    report.state,
                    report.road_name,
                    report.camera_type,
                    report.description,
                    report.source,
                    report.source_url,
                ),
            )

            created_report = cursor.fetchone()

        connection.commit()

        return {
            "success": True,
            "report": created_report,
        }

    except Exception as exc:
        if connection:
            connection.rollback()

        logger.error("Failed to submit camera report: %s", exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to submit camera report",
        )

    finally:
        if connection:
            connection.close()


