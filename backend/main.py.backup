import os
import logging
from pathlib import Path
from datetime import datetime
from typing import Optional, Any

from dotenv import load_dotenv

from fastapi import FastAPI, HTTPException, Query
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field

import psycopg2
from psycopg2.extras import RealDictCursor


# ============================================================
# ENVIRONMENT CONFIGURATION
# ============================================================

# Project root:
# GlobalCameraMap/
# ├── .env
# ├── backend/
# │   └── main.py
#
BASE_DIR = Path(__file__).resolve().parent.parent
ENV_FILE = BASE_DIR / ".env"

# IMPORTANT:
# Load .env BEFORE reading any DB_* environment variables.
load_dotenv(ENV_FILE, override=True)


# ============================================================
# LOGGING
# ============================================================

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
)

logger = logging.getLogger("global-camera-map")


# ============================================================
# DATABASE CONFIGURATION
# ============================================================

DB_HOST = os.getenv("DB_HOST", "127.0.0.1")
DB_PORT = int(os.getenv("DB_PORT", "5432"))
DB_NAME = os.getenv("DB_NAME", "global_camera")
DB_USER = os.getenv("DB_USER", "camera_admin")
DB_PASSWORD = os.getenv("DB_PASSWORD", "")

logger.info(
    "Database configuration: host=%s port=%s db=%s user=%s",
    DB_HOST,
    DB_PORT,
    DB_NAME,
    DB_USER,
)


# ============================================================
# FASTAPI APPLICATION
# ============================================================

app = FastAPI(
    title="Global Camera Map API",
    description="India Traffic Camera Mapping API",
    version="1.0.0",
)


# ============================================================
# CORS
# ============================================================

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:3000",
        "http://127.0.0.1:3000",
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# ============================================================
# DATABASE CONNECTION
# ============================================================

def get_db_connection():
    """
    Create a PostgreSQL connection using credentials from .env.
    """

    # Reload .env in case the process was started before .env changed.
    load_dotenv(ENV_FILE, override=True)

    password = os.getenv("DB_PASSWORD", "")

    if not password:
        logger.error("DB_PASSWORD is empty. PostgreSQL password is required.")
        raise HTTPException(
            status_code=500,
            detail="Unable to connect to database: DB_PASSWORD is empty",
        )

    try:
        connection = psycopg2.connect(
            host=os.getenv("DB_HOST", "127.0.0.1"),
            port=int(os.getenv("DB_PORT", "5432")),
            database=os.getenv("DB_NAME", "global_camera"),
            user=os.getenv("DB_USER", "camera_admin"),
            password=password,
            connect_timeout=5,
        )

        return connection

    except psycopg2.Error as exc:
        logger.error("Database connection failed: %s", exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to connect to database",
        )


# ============================================================
# PYDANTIC MODELS
# ============================================================

class CameraCreate(BaseModel):
    latitude: float
    longitude: float

    country: str = "India"
    city: Optional[str] = None
    state: Optional[str] = None
    road_name: Optional[str] = None

    camera_type: Optional[str] = "Traffic Camera"
    enforcement_type: Optional[str] = None

    speed_limit: Optional[int] = None

    status: Optional[str] = "pending"
    verification_status: Optional[str] = "pending"

    source: Optional[str] = None
    source_url: Optional[str] = None
    last_verified: Optional[datetime] = None


class CameraUpdate(BaseModel):
    latitude: Optional[float] = None
    longitude: Optional[float] = None

    country: Optional[str] = None
    city: Optional[str] = None
    state: Optional[str] = None
    road_name: Optional[str] = None

    camera_type: Optional[str] = None
    enforcement_type: Optional[str] = None

    speed_limit: Optional[int] = None

    status: Optional[str] = None
    verification_status: Optional[str] = None

    source: Optional[str] = None
    source_url: Optional[str] = None
    last_verified: Optional[datetime] = None


class CameraReport(BaseModel):
    latitude: float
    longitude: float

    city: Optional[str] = None
    state: Optional[str] = None
    road_name: Optional[str] = None

    camera_type: Optional[str] = None
    description: Optional[str] = None

    source: Optional[str] = None
    source_url: Optional[str] = None


# ============================================================
# STARTUP / SHUTDOWN
# ============================================================

@app.on_event("startup")
def startup_event():
    logger.info("Starting Global Camera Map API")

    try:
        connection = get_db_connection()

        with connection.cursor() as cursor:
            cursor.execute("SELECT 1")
            cursor.fetchone()

        connection.close()

        logger.info("Database connection successful")

    except Exception as exc:
        logger.error(
            "Application started but database is unavailable: %s",
            exc,
        )


@app.on_event("shutdown")
def shutdown_event():
    logger.info("Shutting down Global Camera Map API")


# ============================================================
# ROOT
# ============================================================

@app.get("/")
def root():
    return {
        "name": "Global Camera Map API",
        "version": "1.0.0",
        "status": "running",
        "database": DB_NAME,
        "documentation": "/docs",
    }


# ============================================================
# HEALTH CHECK
# ============================================================

@app.get("/health")
def health_check():
    """
    Check whether the API and PostgreSQL database are available.
    """

    try:
        connection = get_db_connection()

        with connection.cursor() as cursor:
            cursor.execute("SELECT 1")
            cursor.fetchone()

        connection.close()

        return {
            "status": "healthy",
            "database": "connected",
        }

    except HTTPException:
        return {
            "status": "unhealthy",
            "database": "disconnected",
            "error": "Unable to connect to database",
        }

    except Exception as exc:
        logger.error("Health check failed: %s", exc)

        return {
            "status": "unhealthy",
            "database": "disconnected",
            "error": str(exc),
        }


# ============================================================
# DATABASE STATUS
# ============================================================

@app.get("/api/database/status")
def database_status():
    try:
        connection = get_db_connection()

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute("SELECT current_database() AS database")
            database = cursor.fetchone()

            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM cameras
                """
            )

            camera_count = cursor.fetchone()

        connection.close()

        return {
            "status": "connected",
            "database": database["database"],
            "camera_count": camera_count["count"],
        }

    except Exception as exc:
        logger.error("Database status failed: %s", exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve database status",
        )


# ============================================================
# GET ALL CAMERAS
# ============================================================

@app.get("/api/cameras")
def get_cameras(
    city: Optional[str] = Query(default=None),
    state: Optional[str] = Query(default=None),
    camera_type: Optional[str] = Query(default=None),
    status: Optional[str] = Query(default=None),
    verification_status: Optional[str] = Query(default=None),
    limit: int = Query(default=5000, ge=1, le=50000),
):
    """
    Return cameras from PostgreSQL.

    Supports optional filters:
        ?city=Chandigarh
        ?state=Himachal Pradesh
        ?camera_type=Speed Camera
        ?status=active
        ?verification_status=verified
    """

    connection = None

    try:
        connection = get_db_connection()

        query = """
            SELECT
                id,
                latitude,
                longitude,
                country,
                city,
                state,
                road_name,
                camera_type,
                enforcement_type,
                speed_limit,
                status,
                verification_status,
                source,
                source_url,
                last_verified,
                created_at,
                updated_at
            FROM cameras
            WHERE 1=1
        """

        parameters = []

        if city:
            query += " AND LOWER(city) = LOWER(%s)"
            parameters.append(city)

        if state:
            query += " AND LOWER(state) = LOWER(%s)"
            parameters.append(state)

        if camera_type:
            query += " AND LOWER(camera_type) = LOWER(%s)"
            parameters.append(camera_type)

        if status:
            query += " AND LOWER(status) = LOWER(%s)"
            parameters.append(status)

        if verification_status:
            query += " AND LOWER(verification_status) = LOWER(%s)"
            parameters.append(verification_status)

        query += """
            ORDER BY id ASC
            LIMIT %s
        """

        parameters.append(limit)

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:
            cursor.execute(query, parameters)
            cameras = cursor.fetchall()

        return {
            "count": len(cameras),
            "cameras": cameras,
        }

    except HTTPException:
        raise

    except Exception as exc:
        logger.error("Failed to retrieve cameras: %s", exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve cameras",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# GET SINGLE CAMERA
# ============================================================

@app.get("/api/cameras/{camera_id}")
def get_camera(camera_id: int):

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                SELECT
                    id,
                    latitude,
                    longitude,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified,
                    created_at,
                    updated_at
                FROM cameras
                WHERE id = %s
                """,
                (camera_id,),
            )

            camera = cursor.fetchone()

        if not camera:
            raise HTTPException(
                status_code=404,
                detail="Camera not found",
            )

        return camera

    except HTTPException:
        raise

    except Exception as exc:
        logger.error("Failed to retrieve camera %s: %s", camera_id, exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve camera",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# CREATE CAMERA
# ============================================================

@app.post("/api/cameras")
def create_camera(camera: CameraCreate):

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                INSERT INTO cameras (
                    latitude,
                    longitude,
                    location,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified
                )
                VALUES (
                    %s,
                    %s,
                    ST_SetSRID(
                        ST_MakePoint(%s, %s),
                        4326
                    )::geography,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s
                )
                RETURNING
                    id,
                    latitude,
                    longitude,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified,
                    created_at,
                    updated_at
                """,
                (
                    camera.latitude,
                    camera.longitude,
                    camera.longitude,
                    camera.latitude,
                    camera.country,
                    camera.city,
                    camera.state,
                    camera.road_name,
                    camera.camera_type,
                    camera.enforcement_type,
                    camera.speed_limit,
                    camera.status,
                    camera.verification_status,
                    camera.source,
                    camera.source_url,
                    camera.last_verified,
                ),
            )

            new_camera = cursor.fetchone()

        connection.commit()

        return new_camera

    except HTTPException:
        raise

    except Exception as exc:
        if connection:
            connection.rollback()

        logger.error("Failed to create camera: %s", exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to create camera",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# UPDATE CAMERA
# ============================================================

@app.put("/api/cameras/{camera_id}")
def update_camera(
    camera_id: int,
    camera: CameraUpdate,
):

    connection = None

    try:
        update_data = camera.model_dump(
            exclude_unset=True,
            exclude_none=True,
        )

        if not update_data:
            raise HTTPException(
                status_code=400,
                detail="No fields provided for update",
            )

        connection = get_db_connection()

        allowed_fields = {
            "latitude",
            "longitude",
            "country",
            "city",
            "state",
            "road_name",
            "camera_type",
            "enforcement_type",
            "speed_limit",
            "status",
            "verification_status",
            "source",
            "source_url",
            "last_verified",
        }

        fields = []
        values = []

        for field, value in update_data.items():

            if field not in allowed_fields:
                continue

            fields.append(f"{field} = %s")
            values.append(value)

        if "latitude" in update_data or "longitude" in update_data:

            with connection.cursor() as cursor:

                cursor.execute(
                    """
                    SELECT latitude, longitude
                    FROM cameras
                    WHERE id = %s
                    """,
                    (camera_id,),
                )

                existing = cursor.fetchone()

            if not existing:
                raise HTTPException(
                    status_code=404,
                    detail="Camera not found",
                )

            latitude = update_data.get(
                "latitude",
                existing[0],
            )

            longitude = update_data.get(
                "longitude",
                existing[1],
            )

            fields.append(
                """
                location = ST_SetSRID(
                    ST_MakePoint(%s, %s),
                    4326
                )::geography
                """
            )

            values.extend([longitude, latitude])

        fields.append("updated_at = NOW()")

        values.append(camera_id)

        query = f"""
            UPDATE cameras
            SET {", ".join(fields)}
            WHERE id = %s
            RETURNING
                id,
                latitude,
                longitude,
                country,
                city,
                state,
                road_name,
                camera_type,
                enforcement_type,
                speed_limit,
                status,
                verification_status,
                source,
                source_url,
                last_verified,
                created_at,
                updated_at
        """

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:
            cursor.execute(query, values)
            updated_camera = cursor.fetchone()

        if not updated_camera:
            connection.rollback()

            raise HTTPException(
                status_code=404,
                detail="Camera not found",
            )

        connection.commit()

        return updated_camera

    except HTTPException:
        raise

    except Exception as exc:
        if connection:
            connection.rollback()

        logger.error("Failed to update camera %s: %s", camera_id, exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to update camera",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# DELETE CAMERA
