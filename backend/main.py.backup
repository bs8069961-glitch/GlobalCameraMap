@app.get("/api/reports/pending")
def get_pending_reports():

    connection = None

    try:
        connection = get_db_connection()

        # Make sure the table exists.
        with connection.cursor() as cursor:
            cursor.execute(
                """
                CREATE TABLE IF NOT EXISTS camera_reports (
                    id SERIAL PRIMARY KEY,

                    latitude DOUBLE PRECISION NOT NULL,
                    longitude DOUBLE PRECISION NOT NULL,

                    city VARCHAR(255),
                    state VARCHAR(255),
                    road_name VARCHAR(500),

                    camera_type VARCHAR(255),
                    description TEXT,

                    source VARCHAR(500),
                    source_url TEXT,

                    status VARCHAR(50) DEFAULT 'pending',

                    created_at TIMESTAMP DEFAULT NOW(),
                    updated_at TIMESTAMP DEFAULT NOW()
                )
                """
            )

        connection.commit()

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                SELECT *
                FROM camera_reports
                WHERE LOWER(status) = 'pending'
                ORDER BY created_at DESC
                """
            )

            reports = cursor.fetchall()

        return {
            "count": len(reports),
            "reports": reports,
        }

    except HTTPException:
        raise

    except Exception as exc:
        if connection:
            connection.rollback()

        logger.error(
            "Failed to retrieve pending reports: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve pending reports",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# GET ALL REPORTS
# ============================================================

@app.get("/api/reports")
def get_reports(
    status: Optional[str] = Query(default=None),
):

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor() as cursor:
            cursor.execute(
                """
                CREATE TABLE IF NOT EXISTS camera_reports (
                    id SERIAL PRIMARY KEY,

                    latitude DOUBLE PRECISION NOT NULL,
                    longitude DOUBLE PRECISION NOT NULL,

                    city VARCHAR(255),
                    state VARCHAR(255),
                    road_name VARCHAR(500),

                    camera_type VARCHAR(255),
                    description TEXT,

                    source VARCHAR(500),
                    source_url TEXT,

                    status VARCHAR(50) DEFAULT 'pending',

                    created_at TIMESTAMP DEFAULT NOW(),
                    updated_at TIMESTAMP DEFAULT NOW()
                )
                """
            )

        connection.commit()

        query = """
            SELECT *
            FROM camera_reports
            WHERE 1=1
        """

        values = []

        if status:
            query += " AND LOWER(status) = LOWER(%s)"
            values.append(status)

        query += " ORDER BY created_at DESC"

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:
            cursor.execute(query, values)
            reports = cursor.fetchall()

        return {
            "count": len(reports),
            "reports": reports,
        }

    except Exception as exc:
        if connection:
            connection.rollback()

        logger.error("Failed to retrieve reports: %s", exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve reports",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# APPROVE REPORT
# ============================================================

@app.post("/api/reports/{report_id}/approve")
def approve_report(report_id: int):

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                SELECT *
                FROM camera_reports
                WHERE id = %s
                """,
                (report_id,),
            )

            report = cursor.fetchone()

        if not report:
            raise HTTPException(
                status_code=404,
                detail="Report not found",
            )

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                INSERT INTO cameras (
                    latitude,
                    longitude,
                    location,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    status,
                    verification_status,
                    source,
                    source_url
                )
                VALUES (
                    %s,
                    %s,
                    ST_SetSRID(
                        ST_MakePoint(%s, %s),
                        4326
                    )::geography,
                    'India',
                    %s,
                    %s,
                    %s,
                    %s,
                    'active',
                    'pending',
                    %s,
                    %s
                )
                RETURNING id
                """,
                (
                    report["latitude"],
                    report["longitude"],
                    report["longitude"],
                    report["latitude"],
                    report["city"],
                    report["state"],
                    report["road_name"],
                    report["camera_type"] or "Traffic Camera",
                    report["source"],
                    report["source_url"],
                ),
            )

            new_camera = cursor.fetchone()

            cursor.execute(
                """
                UPDATE camera_reports
                SET
                    status = 'approved',
                    updated_at = NOW()
                WHERE id = %s
                """,
                (report_id,),
            )

        connection.commit()

        return {
            "success": True,
            "report_id": report_id,
            "camera_id": new_camera["id"],
            "status": "approved",
        }

    except HTTPException:
        raise

    except Exception as exc:
        if connection:
            connection.rollback()

        logger.error(
            "Failed to approve report %s: %s",
            report_id,
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to approve report",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# REJECT REPORT
# ============================================================

@app.post("/api/reports/{report_id}/reject")
def reject_report(report_id: int):

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor() as cursor:

            cursor.execute(
                """
                UPDATE camera_reports
                SET
                    status = 'rejected',
                    updated_at = NOW()
                WHERE id = %s
                RETURNING id
                """,
                (report_id,),
            )

            result = cursor.fetchone()

        if not result:
            connection.rollback()

            raise HTTPException(
                status_code=404,
                detail="Report not found",
            )

        connection.commit()

        return {
            "success": True,
            "report_id": report_id,
            "status": "rejected",
        }

    except HTTPException:
        raise

    except Exception as exc:
        if connection:
            connection.rollback()

        logger.error(
            "Failed to reject report %s: %s",
            report_id,
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to reject report",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# SEARCH CAMERAS
# ============================================================

@app.get("/api/search")
def search_cameras(
    q: str = Query(..., min_length=1),
):

    connection = None

    try:
        connection = get_db_connection()

        search_term = f"%{q}%"

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                SELECT
                    id,
                    latitude,
                    longitude,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified,
                    created_at,
                    updated_at
                FROM cameras
                WHERE
                    city ILIKE %s
                    OR state ILIKE %s
                    OR road_name ILIKE %s
                    OR camera_type ILIKE %s
                    OR enforcement_type ILIKE %s
                ORDER BY id ASC
                LIMIT 500
                """,
                (
                    search_term,
                    search_term,
                    search_term,
                    search_term,
                    search_term,
                ),
            )

            cameras = cursor.fetchall()

        return {
            "query": q,
            "count": len(cameras),
            "cameras": cameras,
        }

    except Exception as exc:
        logger.error("Camera search failed: %s", exc)

        raise HTTPException(
            status_code=500,
            detail="Unable to search cameras",
        )

    finally:
        if connection:
            connection.close()


# ============================================================
# INDIA ONLY
# ============================================================

@app.get("/api/india/cameras")
def get_india_cameras(
    limit: int = Query(default=5000, ge=1, le=50000),
):

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor(cursor_factory=RealDictCursor) as cursor:

            cursor.execute(
                """
                SELECT
                    id,
                    latitude,
                    longitude,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified,
                    created_at,
                    updated_at
                FROM cameras
                WHERE LOWER(country) = 'india'
                ORDER BY id ASC
                LIMIT %s
                """,
                (limit,),
            )

            cameras = cursor.fetchall()

        return {
            "country": "India",
            "count": len(cameras),
            "cameras": cameras,
        }

    except Exception as exc:
        logger.error(
            "Failed to retrieve India cameras: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve India cameras",
        )

    finally:
        if connection:
            connection.close()


