@app.post("/api/reports/{report_id}/approve")
def approve_report(report_id: int):

    connection = None

    try:

        connection = get_db_connection()

        ensure_reports_table()

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                """
                SELECT *
                FROM camera_reports
                WHERE id = %s
                FOR UPDATE
                """,
                (report_id,),
            )

            report = cursor.fetchone()

            if not report:

                raise HTTPException(
                    status_code=404,
                    detail="Report not found",
                )

            current_status = str(
                report["status"] or ""
            ).strip().lower()

            if current_status != "pending":

                raise HTTPException(
                    status_code=400,
                    detail=(
                        f"Report is already "
                        f"{report['status']}"
                    ),
                )

            camera_type = (
                report.get("camera_type")
                or "Traffic Camera"
            )

            # ------------------------------------------------
            # Find duplicate camera
            # ------------------------------------------------

            cursor.execute(
                """
                SELECT id
                FROM cameras
                WHERE
                    latitude = %s
                    AND longitude = %s
                    AND COALESCE(city, '') =
                        COALESCE(%s, '')
                    AND COALESCE(road_name, '') =
                        COALESCE(%s, '')
                    AND LOWER(
                        COALESCE(camera_type, '')
                    ) = LOWER(%s)
                LIMIT 1
                """,
                (
                    report["latitude"],
                    report["longitude"],
                    report.get("city"),
                    report.get("road_name"),
                    camera_type,
                ),
            )

            existing_camera = cursor.fetchone()

            # ------------------------------------------------
            # Create camera when necessary
            # ------------------------------------------------

            if existing_camera:

                camera_id = existing_camera["id"]

                logger.info(
                    "Report %s matched camera %s",
                    report_id,
                    camera_id,
                )

            else:

                cursor.execute(
                    """
                    INSERT INTO cameras (
                        latitude,
                        longitude,
                        location,
                        country,
                        city,
                        state,
                        road_name,
                        camera_type,
                        status,
                        verification_status,
                        source,
                        source_url
                    )
                    VALUES (
                        %s,
                        %s,
                        ST_SetSRID(
                            ST_MakePoint(%s, %s),
                            4326
                        )::geography,
                        'India',
                        %s,
                        %s,
                        %s,
                        %s,
                        'active',
                        'pending',
                        %s,
                        %s
                    )
                    RETURNING id
                    """,
                    (
                        report["latitude"],
                        report["longitude"],

                        # PostGIS longitude first
                        report["longitude"],
                        report["latitude"],

                        report.get("city"),
                        report.get("state"),
                        report.get("road_name"),
                        camera_type,

                        report.get("source")
                        or "User Report",

                        report.get("source_url"),
                    ),
                )

                new_camera = cursor.fetchone()

                if not new_camera:

                    raise RuntimeError(
                        "Camera insertion returned no ID"
                    )

                camera_id = new_camera["id"]

                logger.info(
                    "Created camera %s from report %s",
                    camera_id,
                    report_id,
                )

            # ------------------------------------------------
            # Approve report
            # ------------------------------------------------

            cursor.execute(
                """
                UPDATE camera_reports
                SET
                    status = 'approved',
                    updated_at = NOW()
                WHERE id = %s
                RETURNING id, status, updated_at
                """,
                (report_id,),
            )

            updated_report = cursor.fetchone()

            if not updated_report:

                raise RuntimeError(
                    "Report status update failed"
                )

        connection.commit()

        return {
            "success": True,
            "report_id": report_id,
            "camera_id": camera_id,
            "status": "approved",
        }

    except HTTPException:
        raise

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.exception(
            "Failed to approve report %s: %s",
            report_id,
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to approve report",
        )

    finally:

        if connection:
            connection.close()


