@app.put("/api/traffic/segments/{segment_id}")
def update_traffic_segment(
    segment_id: int,
    segment: TrafficSegmentUpdate,
):

    connection = None

    try:

        update_data = segment.model_dump(
            exclude_unset=True,
            exclude_none=True,
        )

        if not update_data:

            raise HTTPException(
                status_code=400,
                detail="No fields provided for update",
            )

        connection = get_db_connection()

        # ----------------------------------------------------
        # Get existing coordinates first
        # ----------------------------------------------------

        with connection.cursor() as cursor:

            cursor.execute(
                """
                SELECT
                    start_latitude,
                    start_longitude,
                    end_latitude,
                    end_longitude
                FROM traffic_segments
                WHERE id = %s
                """,
                (segment_id,),
            )

            existing = cursor.fetchone()

        if not existing:

            raise HTTPException(
                status_code=404,
                detail="Traffic segment not found",
            )

        start_latitude = update_data.get(
            "start_latitude",
            existing[0],
        )

        start_longitude = update_data.get(
            "start_longitude",
            existing[1],
        )

        end_latitude = update_data.get(
            "end_latitude",
            existing[2],
        )

        end_longitude = update_data.get(
            "end_longitude",
            existing[3],
        )

        fields = []
        values = []

        allowed_fields = {
            "road_name",
            "start_latitude",
            "start_longitude",
            "end_latitude",
            "end_longitude",
            "current_speed",
            "free_flow_speed",
            "delay_seconds",
            "congestion_level",
            "traffic_status",
            "source",
            "source_id",
            "observed_at",
        }

        for field, value in update_data.items():

            if field in allowed_fields:

                fields.append(
                    f"{field} = %s"
                )

                values.append(value)

        # ----------------------------------------------------
        # Rebuild geometry whenever coordinates are updated
        # ----------------------------------------------------

        if any(
            coordinate in update_data
            for coordinate in [
                "start_latitude",
                "start_longitude",
                "end_latitude",
                "end_longitude",
            ]
        ):

            fields.append(
                """
                geometry = ST_SetSRID(
                    ST_MakeLine(
                        ST_MakePoint(%s, %s),
                        ST_MakePoint(%s, %s)
                    ),
                    4326
                )
                """
            )

            values.extend(
                [
                    start_longitude,
                    start_latitude,
                    end_longitude,
                    end_latitude,
                ]
            )

        fields.append(
            "updated_at = NOW()"
        )

        values.append(segment_id)

        query = f"""
            UPDATE traffic_segments
            SET {", ".join(fields)}
            WHERE id = %s
            RETURNING
                id,
                road_name,
                start_latitude,
                start_longitude,
                end_latitude,
                end_longitude,
                current_speed,
                free_flow_speed,
                delay_seconds,
                congestion_level,
                traffic_status,
                source,
                source_id,
                observed_at,
                updated_at,
                created_at
        """

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                query,
                values,
            )

            updated_segment = cursor.fetchone()

        if not updated_segment:

            connection.rollback()

            raise HTTPException(
                status_code=404,
                detail="Traffic segment not found",
            )

        connection.commit()

        return {
            "success": True,
            "segment": updated_segment,
        }

    except HTTPException:
        raise

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.exception(
            "Failed to update traffic segment %s: %s",
            segment_id,
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to update traffic segment",
        )

    finally:

        if connection:
            connection.close()


