def ensure_reports_table():
    """
    Create/migrate the camera_reports table safely.

    Existing report data is preserved.
    """

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor() as cursor:

            cursor.execute(
                """
                CREATE TABLE IF NOT EXISTS camera_reports (
                    id SERIAL PRIMARY KEY,

                    latitude DOUBLE PRECISION NOT NULL,
                    longitude DOUBLE PRECISION NOT NULL,

                    city VARCHAR(255),
                    state VARCHAR(255),
                    road_name VARCHAR(500),

                    camera_type VARCHAR(255),

                    reporter_name VARCHAR(255),
                    notes TEXT,

                    description TEXT,

                    source VARCHAR(500),
                    source_url TEXT,

                    image_path TEXT,

                    status VARCHAR(50) DEFAULT 'pending',

                    created_at TIMESTAMP DEFAULT NOW(),
                    updated_at TIMESTAMP DEFAULT NOW()
                )
                """
            )

            columns = [
                "description TEXT",
                "source VARCHAR(500)",
                "source_url TEXT",
                "updated_at TIMESTAMP DEFAULT NOW()",
                "reporter_name VARCHAR(255)",
                "notes TEXT",
                "image_path TEXT",
            ]

            for column in columns:
                cursor.execute(
                    f"""
                    ALTER TABLE camera_reports
                    ADD COLUMN IF NOT EXISTS {column}
                    """
                )

            cursor.execute(
                """
                UPDATE camera_reports
                SET status = 'pending'
                WHERE status IS NULL
                """
            )

            cursor.execute(
                """
                UPDATE camera_reports
                SET updated_at = COALESCE(
                    updated_at,
                    created_at,
                    NOW()
                )
                WHERE updated_at IS NULL
                """
            )

        connection.commit()

        logger.info(
            "camera_reports table checked successfully"
        )

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.exception(
            "Could not initialize camera_reports table: %s",
            exc,
        )

        raise

    finally:

        if connection:
            connection.close()


def ensure_traffic_segments_table():
    """
    Create the traffic_segments table and indexes if necessary.
    """

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor() as cursor:

            cursor.execute(
                """
                CREATE EXTENSION IF NOT EXISTS postgis
                """
            )

            cursor.execute(
                """
                CREATE TABLE IF NOT EXISTS traffic_segments (
                    id SERIAL PRIMARY KEY,

                    road_name TEXT,

                    start_latitude DOUBLE PRECISION,
                    start_longitude DOUBLE PRECISION,

                    end_latitude DOUBLE PRECISION,
                    end_longitude DOUBLE PRECISION,

                    geometry GEOMETRY(LineString, 4326),

                    current_speed DOUBLE PRECISION,
                    free_flow_speed DOUBLE PRECISION,

                    delay_seconds INTEGER DEFAULT 0,

                    congestion_level TEXT DEFAULT 'unknown',

                    traffic_status TEXT DEFAULT 'unknown',

                    source TEXT,

                    source_id TEXT,

                    observed_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
                    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),

                    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
                )
                """
            )

            cursor.execute(
                """
                CREATE INDEX IF NOT EXISTS
                idx_traffic_segments_geometry
                ON traffic_segments
                USING GIST (geometry)
                """
            )

            cursor.execute(
                """
                CREATE INDEX IF NOT EXISTS
                idx_traffic_segments_updated
                ON traffic_segments(updated_at)
                """
            )

            cursor.execute(
                """
                CREATE INDEX IF NOT EXISTS
                idx_traffic_segments_status
                ON traffic_segments(congestion_level)
                """
            )

        connection.commit()

        logger.info(
            "traffic_segments table checked successfully"
        )

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.exception(
            "Could not initialize traffic_segments table: %s",
            exc,
        )

        raise

    finally:

        if connection:
            connection.close()


