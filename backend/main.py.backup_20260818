@app.put("/api/cameras/{camera_id}")
def update_camera(
    camera_id: int,
    camera: CameraUpdate,
):

    connection = None

    try:

        update_data = camera.model_dump(
            exclude_unset=True,
            exclude_none=True,
        )

        if not update_data:

            raise HTTPException(
                status_code=400,
                detail="No fields provided for update",
            )

        connection = get_db_connection()

        allowed_fields = {
            "latitude",
            "longitude",
            "country",
            "city",
            "state",
            "road_name",
            "camera_type",
            "enforcement_type",
            "speed_limit",
            "status",
            "verification_status",
            "source",
            "source_url",
            "last_verified",
        }

        fields = []
        values = []

        for field, value in update_data.items():

            if field in allowed_fields:

                fields.append(
                    f"{field} = %s"
                )

                values.append(value)

        # ----------------------------------------------------
        # Keep PostGIS location synchronized
        # ----------------------------------------------------

        if (
            "latitude" in update_data
            or "longitude" in update_data
        ):

            with connection.cursor() as cursor:

                cursor.execute(
                    """
                    SELECT
                        latitude,
                        longitude
                    FROM cameras
                    WHERE id = %s
                    """,
                    (camera_id,),
                )

                existing = cursor.fetchone()

            if not existing:

                raise HTTPException(
                    status_code=404,
                    detail="Camera not found",
                )

            latitude = update_data.get(
                "latitude",
                existing[0],
            )

            longitude = update_data.get(
                "longitude",
                existing[1],
            )

            fields.append(
                """
                location = ST_SetSRID(
                    ST_MakePoint(%s, %s),
                    4326
                )::geography
                """
            )

            values.extend(
                [
                    longitude,
                    latitude,
                ]
            )

        fields.append(
            "updated_at = NOW()"
        )

        values.append(camera_id)

        query = f"""
            UPDATE cameras
            SET {", ".join(fields)}
            WHERE id = %s
            RETURNING
                id,
                latitude,
                longitude,
                country,
                city,
                state,
                road_name,
                camera_type,
                enforcement_type,
                speed_limit,
                status,
                verification_status,
                source,
                source_url,
                last_verified,
                created_at,
                updated_at
        """

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                query,
                values,
            )

            updated_camera = cursor.fetchone()

        if not updated_camera:

            connection.rollback()

            raise HTTPException(
                status_code=404,
                detail="Camera not found",
            )

        connection.commit()

        return updated_camera

    except HTTPException:
        raise

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.exception(
            "Failed to update camera %s: %s",
            camera_id,
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to update camera",
        )

    finally:

        if connection:
            connection.close()


