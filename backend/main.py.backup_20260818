@app.post("/api/cameras")
def create_camera(camera: CameraCreate):

    connection = None

    try:

        connection = get_db_connection()

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                """
                INSERT INTO cameras (
                    latitude,
                    longitude,
                    location,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified
                )
                VALUES (
                    %s,
                    %s,
                    ST_SetSRID(
                        ST_MakePoint(%s, %s),
                        4326
                    )::geography,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s
                )
                RETURNING
                    id,
                    latitude,
                    longitude,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified,
                    created_at,
                    updated_at
                """,
                (
                    camera.latitude,
                    camera.longitude,

                    # PostGIS = longitude, latitude
                    camera.longitude,
                    camera.latitude,

                    camera.country,
                    camera.city,
                    camera.state,
                    camera.road_name,
                    camera.camera_type,
                    camera.enforcement_type,
                    camera.speed_limit,
                    camera.status,
                    camera.verification_status,
                    camera.source,
                    camera.source_url,
                    camera.last_verified,
                ),
            )

            new_camera = cursor.fetchone()

        connection.commit()

        return new_camera

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.exception(
            "Failed to create camera: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to create camera",
        )

    finally:

        if connection:
            connection.close()


