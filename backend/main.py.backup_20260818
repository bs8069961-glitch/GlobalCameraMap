@app.get("/api/cameras/stats")
def camera_statistics():

    connection = None

    try:

        connection = get_db_connection()

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                """
                SELECT COUNT(*) AS total
                FROM cameras
                """
            )
            total = cursor.fetchone()["total"]

            cursor.execute(
                """
                SELECT COUNT(*) AS active
                FROM cameras
                WHERE LOWER(
                    COALESCE(status, '')
                ) = 'active'
                """
            )
            active = cursor.fetchone()["active"]

            cursor.execute(
                """
                SELECT COUNT(*) AS verified
                FROM cameras
                WHERE LOWER(
                    COALESCE(verification_status, '')
                ) = 'verified'
                """
            )
            verified = cursor.fetchone()["verified"]

            cursor.execute(
                """
                SELECT COUNT(*) AS pending
                FROM cameras
                WHERE LOWER(
                    COALESCE(verification_status, '')
                ) = 'pending'
                """
            )
            pending = cursor.fetchone()["pending"]

            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM cameras
                WHERE
                    LOWER(
                        COALESCE(camera_type, '')
                    ) LIKE '%speed%'
                    OR LOWER(
                        COALESCE(enforcement_type, '')
                    ) LIKE '%speed%'
                """
            )
            speed_cameras = cursor.fetchone()["count"]

            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM cameras
                WHERE
                    LOWER(
                        COALESCE(camera_type, '')
                    ) LIKE '%red%'
                    OR LOWER(
                        COALESCE(enforcement_type, '')
                    ) LIKE '%red%'
                """
            )
            red_light_cameras = cursor.fetchone()["count"]

            cursor.execute(
                """
                SELECT COUNT(DISTINCT city) AS count
                FROM cameras
                WHERE city IS NOT NULL
                  AND TRIM(city) <> ''
                """
            )
            cities = cursor.fetchone()["count"]

            cursor.execute(
                """
                SELECT
                    COALESCE(state, 'Unknown') AS state,
                    COUNT(*) AS count
                FROM cameras
                GROUP BY state
                ORDER BY count DESC
                """
            )
            by_state = cursor.fetchall()

            cursor.execute(
                """
                SELECT
                    COALESCE(
                        camera_type,
                        'Unknown'
                    ) AS camera_type,
                    COUNT(*) AS count
                FROM cameras
                GROUP BY camera_type
                ORDER BY count DESC
                """
            )
            by_type = cursor.fetchall()

        return {
            "total": total,
            "active": active,
            "verified": verified,
            "pending": pending,
            "speed_cameras": speed_cameras,
            "red_light_cameras": red_light_cameras,
            "cities": cities,
            "by_state": by_state,
            "by_camera_type": by_type,
        }

    except Exception as exc:

        logger.exception(
            "Failed to retrieve statistics: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve camera statistics",
        )

    finally:

        if connection:
            connection.close()


