        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                """
                SELECT COUNT(*) AS total
                FROM traffic_segments
                """
            )

            total = cursor.fetchone()["total"]

            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM traffic_segments
                WHERE LOWER(
                    COALESCE(congestion_level, '')
                ) = 'low'
                """
            )

            low = cursor.fetchone()["count"]

            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM traffic_segments
                WHERE LOWER(
                    COALESCE(congestion_level, '')
                ) = 'moderate'
                """
            )

            moderate = cursor.fetchone()["count"]

            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM traffic_segments
                WHERE LOWER(
                    COALESCE(congestion_level, '')
                ) = 'high'
                """
            )

            high = cursor.fetchone()["count"]

            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM traffic_segments
                WHERE LOWER(
                    COALESCE(congestion_level, '')
                ) = 'severe'
                """
            )

            severe = cursor.fetchone()["count"]

            cursor.execute(
                """
                SELECT
                    COALESCE(
                        congestion_level,
                        'unknown'
                    ) AS congestion_level,
                    COUNT(*) AS count
                FROM traffic_segments
                GROUP BY congestion_level
                ORDER BY count DESC
                """
            )

            by_congestion = cursor.fetchall()

            cursor.execute(
                """
                SELECT
                    COALESCE(
                        traffic_status,
                        'unknown'
                    ) AS traffic_status,
                    COUNT(*) AS count
                FROM traffic_segments
                GROUP BY traffic_status
                ORDER BY count DESC
                """
            )

            by_status = cursor.fetchall()

        return {
            "total": total,
            "low": low,
            "moderate": moderate,
            "high": high,
            "severe": severe,
            "by_congestion": by_congestion,
            "by_status": by_status,
        }

    except Exception as exc:

        logger.exception(
            "Failed to retrieve traffic statistics: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve traffic statistics",
        )

    finally:

        if connection:
            connection.close()


