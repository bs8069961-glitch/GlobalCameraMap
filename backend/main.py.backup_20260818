@app.get("/api/cameras")
def get_cameras(
    city: Optional[str] = Query(default=None),
    state: Optional[str] = Query(default=None),
    camera_type: Optional[str] = Query(default=None),
    status: Optional[str] = Query(default=None),
    verification_status: Optional[str] = Query(default=None),

    limit: int = Query(
        default=5000,
        ge=1,
        le=50000,
    ),
):

    connection = None

    try:

        connection = get_db_connection()

        query = """
            SELECT
                id,
                latitude,
                longitude,
                country,
                city,
                state,
                road_name,
                camera_type,
                enforcement_type,
                speed_limit,
                status,
                verification_status,
                source,
                source_url,
                last_verified,
                created_at,
                updated_at
            FROM cameras
            WHERE 1=1
        """

        parameters = []

        if city:
            query += """
                AND LOWER(city) = LOWER(%s)
            """
            parameters.append(city)

        if state:
            query += """
                AND LOWER(state) = LOWER(%s)
            """
            parameters.append(state)

        if camera_type:
            query += """
                AND LOWER(camera_type) = LOWER(%s)
            """
            parameters.append(camera_type)

        if status:
            query += """
                AND LOWER(status) = LOWER(%s)
            """
            parameters.append(status)

        if verification_status:
            query += """
                AND LOWER(verification_status) = LOWER(%s)
            """
            parameters.append(verification_status)

        query += """
            ORDER BY id ASC
            LIMIT %s
        """

        parameters.append(limit)

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                query,
                parameters,
            )

            cameras = cursor.fetchall()

        return {
            "count": len(cameras),
            "cameras": cameras,
        }

    except Exception as exc:

        logger.exception(
            "Failed to retrieve cameras: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve cameras",
        )

    finally:

        if connection:
            connection.close()


