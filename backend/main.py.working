        "route_cameras": "/api/route/cameras",
    }


# ============================================================
# HEALTH CHECK
# ============================================================

@app.get("/health")
def health_check():

    connection = None

    try:

        connection = get_db_connection()

        with connection.cursor() as cursor:
            cursor.execute("SELECT 1")
            cursor.fetchone()

        return {
            "status": "healthy",
            "database": "connected",
        }

    except Exception as exc:

        logger.error(
            "Health check failed: %s",
            exc,
        )

        return {
            "status": "unhealthy",
            "database": "disconnected",
            "error": str(exc),
        }

    finally:

        if connection:
            connection.close()


# ============================================================
# DATABASE STATUS
# ============================================================

@app.get("/api/database/status")
def database_status():

    connection = None

    try:

        connection = get_db_connection()

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                """
                SELECT current_database() AS database
                """
            )

            database = cursor.fetchone()

            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM cameras
                """
            )

            camera_count = cursor.fetchone()

        return {
            "status": "connected",
            "database": database["database"],
            "camera_count": camera_count["count"],
        }

    except Exception as exc:

        logger.error(
            "Database status failed: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve database status",
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# GET ALL CAMERAS
# ============================================================

@app.get("/api/cameras")
def get_cameras(
    city: Optional[str] = Query(default=None),
    state: Optional[str] = Query(default=None),
    camera_type: Optional[str] = Query(default=None),
    status: Optional[str] = Query(default=None),
    verification_status: Optional[str] = Query(default=None),

    limit: int = Query(
        default=5000,
        ge=1,
        le=50000,
    ),
):

    connection = None

    try:

        connection = get_db_connection()

        query = """
            SELECT
                id,
                latitude,
                longitude,
                country,
                city,
                state,
                road_name,
                camera_type,
                enforcement_type,
                speed_limit,
                status,
                verification_status,
                source,
                source_url,
                last_verified,
                created_at,
                updated_at
            FROM cameras
            WHERE 1=1
        """

        parameters = []

        if city:
            query += """
                AND LOWER(city) = LOWER(%s)
            """
            parameters.append(city)

        if state:
            query += """
                AND LOWER(state) = LOWER(%s)
            """
            parameters.append(state)

        if camera_type:
            query += """
                AND LOWER(camera_type) = LOWER(%s)
            """
            parameters.append(camera_type)

        if status:
            query += """
                AND LOWER(status) = LOWER(%s)
            """
            parameters.append(status)

        if verification_status:
            query += """
                AND LOWER(verification_status) = LOWER(%s)
            """
            parameters.append(verification_status)

        query += """
            ORDER BY id ASC
            LIMIT %s
        """

        parameters.append(limit)

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                query,
                parameters,
            )

            cameras = cursor.fetchall()

        return {
            "count": len(cameras),
            "cameras": cameras,
        }

    except Exception as exc:

        logger.error(
            "Failed to retrieve cameras: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve cameras",
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# CAMERA STATISTICS
# ============================================================

@app.get("/api/cameras/stats")
def camera_statistics():

    connection = None

    try:

        connection = get_db_connection()

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            # Total
            cursor.execute(
                """
                SELECT COUNT(*) AS total
                FROM cameras
                """
            )

            total = cursor.fetchone()["total"]

            # Active
            cursor.execute(
                """
                SELECT COUNT(*) AS active
                FROM cameras
                WHERE LOWER(COALESCE(status, '')) = 'active'
                """
            )

            active = cursor.fetchone()["active"]

            # Verified
            cursor.execute(
                """
                SELECT COUNT(*) AS verified
                FROM cameras
                WHERE LOWER(
                    COALESCE(verification_status, '')
                ) = 'verified'
                """
            )

            verified = cursor.fetchone()["verified"]

            # Pending verification
            cursor.execute(
                """
                SELECT COUNT(*) AS pending
                FROM cameras
                WHERE LOWER(
                    COALESCE(verification_status, '')
                ) = 'pending'
                """
            )

            pending = cursor.fetchone()["pending"]

            # Speed cameras
            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM cameras
                WHERE
                    LOWER(COALESCE(camera_type, '')) LIKE '%speed%'
                    OR LOWER(COALESCE(enforcement_type, '')) LIKE '%speed%'
                """
            )

            speed_cameras = cursor.fetchone()["count"]

            # Red light cameras
            cursor.execute(
                """
                SELECT COUNT(*) AS count
                FROM cameras
                WHERE
                    LOWER(COALESCE(camera_type, '')) LIKE '%red%'
                    OR LOWER(COALESCE(enforcement_type, '')) LIKE '%red%'
                """
            )

            red_light_cameras = cursor.fetchone()["count"]

            # Cities
            cursor.execute(
                """
                SELECT COUNT(DISTINCT city) AS count
                FROM cameras
                WHERE city IS NOT NULL
                  AND TRIM(city) <> ''
                """
            )

            cities = cursor.fetchone()["count"]

            # Cameras by state
            cursor.execute(
                """
                SELECT
                    COALESCE(state, 'Unknown') AS state,
                    COUNT(*) AS count
                FROM cameras
                GROUP BY state
                ORDER BY count DESC
                """
            )

            by_state = cursor.fetchall()

            # Cameras by type
            cursor.execute(
                """
                SELECT
                    COALESCE(
                        camera_type,
                        'Unknown'
                    ) AS camera_type,
                    COUNT(*) AS count
                FROM cameras
                GROUP BY camera_type
                ORDER BY count DESC
                """
            )

            by_type = cursor.fetchall()

        return {
            "total": total,
            "active": active,
            "verified": verified,
            "pending": pending,

            "speed_cameras": speed_cameras,
            "red_light_cameras": red_light_cameras,
            "cities": cities,

            "by_state": by_state,
            "by_camera_type": by_type,
        }

    except Exception as exc:

        logger.error(
            "Failed to retrieve statistics: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve camera statistics",
        )

    finally:

        if connection:
            connection.close()


