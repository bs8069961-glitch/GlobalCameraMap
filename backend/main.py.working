@app.get("/api/cameras/{camera_id}")
def get_camera(camera_id: int):

    connection = None

    try:

        connection = get_db_connection()

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                """
                SELECT
                    id,
                    latitude,
                    longitude,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified,
                    created_at,
                    updated_at
                FROM cameras
                WHERE id = %s
                """,
                (camera_id,),
