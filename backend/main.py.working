import os
import logging
from pathlib import Path
from datetime import datetime
from typing import Optional

from dotenv import load_dotenv

from fastapi import FastAPI, HTTPException, Query
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

from psycopg2.extras import RealDictCursor

from backend.database import get_db_connection
from backend.routes.routing import router as routing_router


# ============================================================
# ENVIRONMENT CONFIGURATION
# ============================================================

BASE_DIR = Path(__file__).resolve().parent.parent
ENV_FILE = BASE_DIR / ".env"

load_dotenv(ENV_FILE, override=True)


# ============================================================
# LOGGING
# ============================================================

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
)

logger = logging.getLogger("global-camera-map")


# ============================================================
# DATABASE CONFIGURATION
# ============================================================

DB_HOST = os.getenv("DB_HOST", "127.0.0.1")
DB_PORT = int(os.getenv("DB_PORT", "5432"))
DB_NAME = os.getenv("DB_NAME", "global_camera")
DB_USER = os.getenv("DB_USER", "camera_admin")
DB_PASSWORD = os.getenv("DB_PASSWORD", "")

logger.info(
    "Database configuration: host=%s port=%s db=%s user=%s",
    DB_HOST,
    DB_PORT,
    DB_NAME,
    DB_USER,
)


# ============================================================
# FASTAPI APPLICATION
# ============================================================

app = FastAPI(
    title="Global Camera Map API",
    description=(
        "Global traffic camera, route, navigation, "
        "camera reporting and camera statistics API."
    ),
    version="2.1.0",
)


# ============================================================
# CORS
# ============================================================

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:3000",
        "http://127.0.0.1:3000",
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# ============================================================
# ROUTING API
# ============================================================

app.include_router(
    routing_router,
    prefix="/api",
)


# ============================================================
# PYDANTIC MODELS
# ============================================================

class CameraCreate(BaseModel):
    latitude: float
    longitude: float

    country: str = "India"
    city: Optional[str] = None
    state: Optional[str] = None
    road_name: Optional[str] = None

    camera_type: Optional[str] = "Traffic Camera"
    enforcement_type: Optional[str] = None

    speed_limit: Optional[int] = None

    status: Optional[str] = "pending"
    verification_status: Optional[str] = "pending"

    source: Optional[str] = None
    source_url: Optional[str] = None
    last_verified: Optional[datetime] = None


class CameraUpdate(BaseModel):
    latitude: Optional[float] = None
    longitude: Optional[float] = None

    country: Optional[str] = None
    city: Optional[str] = None
    state: Optional[str] = None
    road_name: Optional[str] = None

    camera_type: Optional[str] = None
    enforcement_type: Optional[str] = None

    speed_limit: Optional[int] = None

    status: Optional[str] = None
    verification_status: Optional[str] = None

    source: Optional[str] = None
    source_url: Optional[str] = None
    last_verified: Optional[datetime] = None


class CameraReport(BaseModel):
    latitude: float
    longitude: float

    city: Optional[str] = None
    state: Optional[str] = None
    road_name: Optional[str] = None

    camera_type: Optional[str] = None
    description: Optional[str] = None

    source: Optional[str] = None
    source_url: Optional[str] = None


# ============================================================
# DATABASE HELPERS
# ============================================================

def ensure_reports_table():
    """
    Make sure the camera_reports table exists.
    """

    connection = None

    try:
        connection = get_db_connection()

        with connection.cursor() as cursor:
            cursor.execute(
                """
                CREATE TABLE IF NOT EXISTS camera_reports (
                    id SERIAL PRIMARY KEY,

                    latitude DOUBLE PRECISION NOT NULL,
                    longitude DOUBLE PRECISION NOT NULL,

                    city VARCHAR(255),
                    state VARCHAR(255),
                    road_name VARCHAR(500),

                    camera_type VARCHAR(255),
                    description TEXT,

                    source VARCHAR(500),
                    source_url TEXT,

                    status VARCHAR(50) DEFAULT 'pending',

                    created_at TIMESTAMP DEFAULT NOW(),
                    updated_at TIMESTAMP DEFAULT NOW()
                )
                """
            )

        connection.commit()

        logger.info("camera_reports table checked successfully")

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.warning(
            "Could not initialize camera_reports table: %s",
            exc,
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# STARTUP
# ============================================================

@app.on_event("startup")
def startup_event():

    logger.info("Starting Global Camera Map API")

    try:

        connection = get_db_connection()

        with connection.cursor() as cursor:
            cursor.execute("SELECT 1")
            cursor.fetchone()

        connection.close()

        logger.info("Database connection successful")

        ensure_reports_table()

    except Exception as exc:

        logger.error(
            "Application started but database is unavailable: %s",
            exc,
        )


# ============================================================
# SHUTDOWN
# ============================================================

@app.on_event("shutdown")
def shutdown_event():

    logger.info("Shutting down Global Camera Map API")


