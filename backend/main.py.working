    except Exception as exc:

        logger.error(
            "Failed to retrieve camera %s: %s",
            camera_id,
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to retrieve camera",
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# CREATE CAMERA
# ============================================================

@app.post("/api/cameras")
def create_camera(camera: CameraCreate):

    connection = None

    try:

        connection = get_db_connection()

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                """
                INSERT INTO cameras (
                    latitude,
                    longitude,
                    location,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified
                )
                VALUES (
                    %s,
                    %s,
                    ST_SetSRID(
                        ST_MakePoint(%s, %s),
                        4326
                    )::geography,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s
                )
                RETURNING
                    id,
                    latitude,
                    longitude,
                    country,
                    city,
                    state,
                    road_name,
                    camera_type,
                    enforcement_type,
                    speed_limit,
                    status,
                    verification_status,
                    source,
                    source_url,
                    last_verified,
                    created_at,
                    updated_at
                """,
                (
                    camera.latitude,
                    camera.longitude,

                    # PostGIS expects longitude first
                    camera.longitude,
                    camera.latitude,

                    camera.country,
                    camera.city,
                    camera.state,
                    camera.road_name,
                    camera.camera_type,
                    camera.enforcement_type,
                    camera.speed_limit,
                    camera.status,
                    camera.verification_status,
                    camera.source,
                    camera.source_url,
                    camera.last_verified,
                ),
            )

            new_camera = cursor.fetchone()

        connection.commit()

        return new_camera

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.error(
            "Failed to create camera: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to create camera",
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# UPDATE CAMERA
# ============================================================

@app.put("/api/cameras/{camera_id}")
def update_camera(
    camera_id: int,
    camera: CameraUpdate,
):

    connection = None

    try:

        update_data = camera.model_dump(
            exclude_unset=True,
            exclude_none=True,
        )

        if not update_data:

            raise HTTPException(
                status_code=400,
                detail="No fields provided for update",
            )

        connection = get_db_connection()

        allowed_fields = {
            "latitude",
            "longitude",
            "country",
            "city",
            "state",
            "road_name",
            "camera_type",
            "enforcement_type",
            "speed_limit",
            "status",
            "verification_status",
            "source",
            "source_url",
            "last_verified",
        }

        fields = []
        values = []

        for field, value in update_data.items():

            if field not in allowed_fields:
                continue

            fields.append(
                f"{field} = %s"
            )

            values.append(value)

        # If coordinates are updated, update PostGIS location too.
        if (
            "latitude" in update_data
            or "longitude" in update_data
        ):

            with connection.cursor() as cursor:

                cursor.execute(
                    """
                    SELECT
                        latitude,
                        longitude
                    FROM cameras
                    WHERE id = %s
                    """,
                    (camera_id,),
                )

                existing = cursor.fetchone()

            if not existing:

                raise HTTPException(
                    status_code=404,
                    detail="Camera not found",
                )

            latitude = update_data.get(
                "latitude",
                existing[0],
            )

            longitude = update_data.get(
                "longitude",
                existing[1],
            )

            fields.append(
                """
                location = ST_SetSRID(
                    ST_MakePoint(%s, %s),
                    4326
                )::geography
                """
            )

            values.extend(
                [
                    longitude,
                    latitude,
                ]
            )

        fields.append(
            "updated_at = NOW()"
        )

        values.append(camera_id)

        query = f"""
            UPDATE cameras
            SET {", ".join(fields)}
            WHERE id = %s
            RETURNING
                id,
                latitude,
                longitude,
                country,
                city,
                state,
                road_name,
                camera_type,
                enforcement_type,
                speed_limit,
                status,
                verification_status,
                source,
                source_url,
                last_verified,
                created_at,
                updated_at
        """

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                query,
                values,
            )

            updated_camera = cursor.fetchone()

        if not updated_camera:

            connection.rollback()

            raise HTTPException(
                status_code=404,
                detail="Camera not found",
            )

        connection.commit()

        return updated_camera

    except HTTPException:
        raise

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.error(
            "Failed to update camera %s: %s",
            camera_id,
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to update camera",
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# DELETE CAMERA
# ============================================================

@app.delete("/api/cameras/{camera_id}")
def delete_camera(camera_id: int):

    connection = None

    try:

        connection = get_db_connection()

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                """
                DELETE FROM cameras
                WHERE id = %s
                RETURNING id
                """,
                (camera_id,),
            )

            deleted = cursor.fetchone()

        if not deleted:

            connection.rollback()

            raise HTTPException(
                status_code=404,
                detail="Camera not found",
            )

        connection.commit()

        return {
            "success": True,
            "deleted_id": deleted["id"],
        }

    except HTTPException:
        raise

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.error(
            "Failed to delete camera %s: %s",
            camera_id,
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to delete camera",
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# REPORT CAMERA
# ============================================================

@app.post("/api/reports")
def report_camera(report: CameraReport):

    connection = None

    try:

        connection = get_db_connection()

        ensure_reports_table()

        with connection.cursor(
            cursor_factory=RealDictCursor
        ) as cursor:

            cursor.execute(
                """
                INSERT INTO camera_reports (
                    latitude,
                    longitude,
                    city,
                    state,
                    road_name,
                    camera_type,
                    description,
                    source,
                    source_url,
                    status
                )
                VALUES (
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    %s,
                    'pending'
                )
                RETURNING *
                """,
                (
                    report.latitude,
                    report.longitude,
                    report.city,
                    report.state,
                    report.road_name,
                    report.camera_type,
                    report.description,
                    report.source,
                    report.source_url,
                ),
            )

            created_report = cursor.fetchone()

        connection.commit()

        return {
            "success": True,
            "report": created_report,
        }

    except Exception as exc:

        if connection:
            connection.rollback()

        logger.error(
            "Failed to submit camera report: %s",
            exc,
        )

        raise HTTPException(
            status_code=500,
            detail="Unable to submit camera report",
        )

    finally:

        if connection:
            connection.close()


