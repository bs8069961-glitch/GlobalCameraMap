# ============================================================
# ROUTE PLANNING
# ============================================================
#
# RADARBOT-STYLE FEATURE
#
# User provides:
#
# Point A
# Point B
#
# Backend:
#
# 1. Sends A -> B to OSRM
# 2. Gets driving route
# 3. Converts route into PostGIS geometry
# 4. Searches cameras near the route
# 5. Calculates:
#
#       distance from route
#       approximate distance along route
#
# 6. Returns route + nearby cameras
#
# ============================================================

@app.post("/api/route")
def create_route(
    body: dict = Body(...)
):

    conn = None
    cursor = None

    try:

        # ====================================================
        # READ POINT A
        # ====================================================

        start_latitude = body.get(
            "start_latitude"
        )

        start_longitude = body.get(
            "start_longitude"
        )

        # ====================================================
        # READ POINT B
        # ====================================================

        end_latitude = body.get(
            "end_latitude"
        )

        end_longitude = body.get(
            "end_longitude"
        )

        # ====================================================
        # CAMERA SEARCH RADIUS
        # ====================================================

        radius_meters = body.get(
            "camera_radius_meters",
            DEFAULT_CAMERA_ROUTE_RADIUS_METERS
        )

        # ====================================================
        # VALIDATE REQUIRED VALUES
        # ====================================================

        if start_latitude is None:

            raise HTTPException(
                status_code=400,
                detail="start_latitude is required"
            )

        if start_longitude is None:

            raise HTTPException(
                status_code=400,
                detail="start_longitude is required"
            )

        if end_latitude is None:

            raise HTTPException(
                status_code=400,
                detail="end_latitude is required"
            )

        if end_longitude is None:

            raise HTTPException(
                status_code=400,
                detail="end_longitude is required"
            )

        # ====================================================
        # CONVERT COORDINATES
        # ====================================================

        try:

            start_latitude = float(
                start_latitude
            )

            start_longitude = float(
                start_longitude
            )

            end_latitude = float(
                end_latitude
            )

            end_longitude = float(
                end_longitude
            )

            radius_meters = float(
                radius_meters
            )

        except (
            TypeError,
            ValueError
        ):

            raise HTTPException(
                status_code=400,
                detail=(
                    "Coordinates and "
                    "camera radius must be numeric"
                )
            )

        # ====================================================
        # VALIDATE COORDINATE RANGES
        # ====================================================

        if not -90 <= start_latitude <= 90:

            raise HTTPException(
                status_code=400,
                detail="Invalid start latitude"
            )

        if not -180 <= start_longitude <= 180:

            raise HTTPException(
                status_code=400,
                detail="Invalid start longitude"
            )

        if not -90 <= end_latitude <= 90:

            raise HTTPException(
                status_code=400,
                detail="Invalid end latitude"
            )

        if not -180 <= end_longitude <= 180:

            raise HTTPException(
                status_code=400,
                detail="Invalid end longitude"
            )

        # ====================================================
        # VALIDATE RADIUS
        # ====================================================

        if radius_meters <= 0:

            raise HTTPException(
                status_code=400,
                detail=(
                    "camera_radius_meters "
                    "must be greater than 0"
                )
            )

        if radius_meters > MAX_CAMERA_ROUTE_RADIUS_METERS:

            raise HTTPException(
                status_code=400,
                detail=(
                    "camera_radius_meters cannot "
                    f"exceed {MAX_CAMERA_ROUTE_RADIUS_METERS} "
                    "meters"
                )
            )

        # ====================================================
        # PREVENT SAME POINT
        # ====================================================

        if (
            start_latitude == end_latitude
            and
            start_longitude == end_longitude
        ):

            raise HTTPException(
                status_code=400,
                detail=(
                    "Point A and Point B "
                    "cannot be identical"
                )
            )

        # ====================================================
        # BUILD OSRM URL
        # ====================================================
        #
        # IMPORTANT:
        #
        # OSRM uses:
        #
        # longitude,latitude
        #
        # NOT:
        #
        # latitude,longitude
        #
        # ====================================================

        osrm_url = (
            f"{OSRM_BASE_URL}/route/v1/driving/"
            f"{start_longitude},{start_latitude};"
            f"{end_longitude},{end_latitude}"
        )

        osrm_params = {
            "overview": "full",
            "geometries": "geojson",
            "steps": "false"
        }

        logger.info(
            "Requesting route: %s -> %s",
            (
                start_latitude,
                start_longitude
            ),
            (
                end_latitude,
                end_longitude
            )
        )

        # ====================================================
        # REQUEST ROUTE FROM OSRM
        # ====================================================

        try:

            with httpx.Client(
                timeout=30.0
            ) as client:

                response = client.get(
                    osrm_url,
                    params=osrm_params
                )

        except httpx.RequestError as e:

            logger.error(
                "OSRM request failed: %s",
                str(e)
            )

            raise HTTPException(
                status_code=502,
                detail=(
                    "Unable to connect to "
                    "routing service"
                )
            )

        # ====================================================
        # CHECK OSRM RESPONSE
        # ====================================================

        if response.status_code != 200:

            logger.error(
                "OSRM returned HTTP %s: %s",
                response.status_code,
                response.text
            )

            raise HTTPException(
                status_code=502,
                detail=(
                    "Routing service returned "
                    "an error"
                )
            )

        try:

            route_data = response.json()

        except Exception:

            raise HTTPException(
                status_code=502,
                detail=(
                    "Routing service returned "
                    "invalid JSON"
                )
            )

        # ====================================================
        # CHECK ROUTE STATUS
        # ====================================================

        if route_data.get("code") != "Ok":

            logger.error(
                "OSRM routing failed: %s",
                route_data
            )

            raise HTTPException(
                status_code=400,
                detail=(
                    route_data.get(
                        "message",
                        "No route found"
                    )
                )
            )

        routes = route_data.get(
            "routes",
            []
        )

        if not routes:

            raise HTTPException(
                status_code=404,
                detail="No driving route found"
            )

        # ====================================================
        # FIRST ROUTE
        # ====================================================

        selected_route = routes[0]

        route_geometry = selected_route.get(
            "geometry"
        )

        if not route_geometry:

            raise HTTPException(
                status_code=502,
                detail=(
                    "Routing service did not "
                    "return route geometry"
                )
            )

        route_coordinates = route_geometry.get(
            "coordinates",
            []
        )

        if len(route_coordinates) < 2:

            raise HTTPException(
                status_code=502,
                detail=(
                    "Route geometry contains "
                    "insufficient coordinates"
                )
            )

        # ====================================================
        # ROUTE DISTANCE
        # ====================================================

        route_distance_meters = float(
            selected_route.get(
                "distance",
                0
            )
        )

        route_duration_seconds = float(
            selected_route.get(
                "duration",
                0
            )
        )

        route_distance_km = (
            route_distance_meters / 1000
        )

        route_duration_minutes = (
            route_duration_seconds / 60
        )

        # ====================================================
        # ROUTE GEOMETRY FOR POSTGIS
        # ====================================================

        route_geometry_json = json.dumps(
            route_geometry
        )

        # ====================================================
        # DATABASE
        # ====================================================

        conn = get_db_connection()

        cursor = conn.cursor(
            cursor_factory=RealDictCursor
        )

        # ====================================================
        # FIND CAMERAS NEAR ROUTE
        # ====================================================
        #
        # We search within radius_meters.
        #
        # Example:
        #
        # 300 meters
        #
        # means cameras within 300m of the
        # driving route are returned.
        #
        # ====================================================

        cursor.execute(
            """
            WITH route AS
            (
                SELECT
                    ST_SetSRID(
                        ST_GeomFromGeoJSON(%s),
                        4326
                    ) AS geom
            )

            SELECT

                c.id,

                c.latitude,

                c.longitude,

                c.country,

                c.state,

                c.city,

                c.road_name,

                c.camera_type,

                c.speed_limit,

                c.status,

                c.verification_status,

                c.source,

                c.source_url,

                c.created_at,

                c.updated_at,

                ST_Distance(
                    c.location,
                    route.geom::geography
                ) AS distance_from_route_meters,

                (
                    ST_LineLocatePoint(
                        route.geom,
                        c.location::geometry
                    )
                    *
                    ST_Length(
                        route.geom::geography
                    )
                ) AS distance_along_route_meters

            FROM cameras c

            CROSS JOIN route

            WHERE
                ST_DWithin(
                    c.location,
                    route.geom::geography,
                    %s
                )

            ORDER BY
                distance_along_route_meters ASC,
                distance_from_route_meters ASC

            """,
            (
                route_geometry_json,
                radius_meters
            )
        )

        cameras = cursor.fetchall()

        # ====================================================
        # FORMAT CAMERA RESULTS
        # ====================================================

        route_cameras = []

        for camera in cameras:

            camera_data = dict(camera)

            distance_from_route = float(
                camera_data.get(
                    "distance_from_route_meters",
                    0
                )
                or 0
            )

            distance_along_route = float(
                camera_data.get(
                    "distance_along_route_meters",
                    0
                )
                or 0
            )

            camera_data[
                "distance_from_route_meters"
            ] = round(
                distance_from_route,
                2
            )

            camera_data[
                "distance_from_route_km"
            ] = round(
                distance_from_route / 1000,
                3
            )

            camera_data[
                "distance_along_route_meters"
            ] = round(
                distance_along_route,
                2
            )

            camera_data[
                "distance_along_route_km"
            ] = round(
                distance_along_route / 1000,
                3
            )

            # ------------------------------------------------
            # RADARBOT-STYLE WARNING CATEGORY
            # ------------------------------------------------

            if distance_along_route <= 100:

                warning_level = "immediate"

            elif distance_along_route <= 500:

                warning_level = "very_close"

            elif distance_along_route <= 1000:

                warning_level = "near"

            else:

                warning_level = "ahead"

            camera_data[
                "warning_level"
            ] = warning_level

            route_cameras.append(
                camera_data
            )

        # ====================================================
        # CREATE WARNING SUMMARY
        # ====================================================

        immediate_count = 0
        very_close_count = 0
        near_count = 0

        for camera in route_cameras:

            warning_level = camera.get(
                "warning_level"
            )

            if warning_level == "immediate":

                immediate_count += 1

            elif warning_level == "very_close":

                very_close_count += 1

            elif warning_level == "near":

                near_count += 1

        # ====================================================
        # LOG RESULT
        # ====================================================

        logger.info(
            "Route created: %.2f km, "
            "%.2f minutes, "
            "%s cameras nearby",
            route_distance_km,
            route_duration_minutes,
            len(route_cameras)
        )

        # ====================================================
        # RESPONSE
        # ====================================================

        return {

            "success": True,

            "route": {

                "distance_meters": round(
                    route_distance_meters,
                    2
                ),

                "distance_km": round(
                    route_distance_km,
                    3
                ),

                "duration_seconds": round(
                    route_duration_seconds,
                    2
                ),

                "duration_minutes": round(
                    route_duration_minutes,
                    2
                ),

                "geometry": route_geometry,

                "coordinates": route_coordinates,

                "start": {
                    "latitude": start_latitude,
                    "longitude": start_longitude
                },

                "end": {
                    "latitude": end_latitude,
                    "longitude": end_longitude
                }
            },

            "camera_search": {

                "radius_meters": radius_meters,

                "total_cameras": len(
                    route_cameras
                ),

                "immediate": immediate_count,

                "very_close": very_close_count,

                "near": near_count
            },

            "cameras": route_cameras
        }

    except HTTPException:

        raise

    except psycopg2.Error as e:

        logger.error(
            "Database error while "
            "finding route cameras: %s",
            str(e)
        )

        raise HTTPException(
            status_code=500,
            detail=(
                "Database error while "
                "finding cameras near route"
            )
        )

    except Exception as e:

        logger.exception(
            "Unexpected route error"
        )

        raise HTTPException(
            status_code=500,
            detail=str(e)
        )

    finally:

        if cursor:

            try:
                cursor.close()
            except Exception:
                pass

        if conn:

            try:
                conn.close()
            except Exception:
                pass


# ============================================================
# ROUTE CAMERAS ONLY
# ============================================================
#
# This endpoint is useful later for the live RadarBot mode.
#
# It accepts:
#
# current location
# route geometry
#
# and returns nearby cameras.
#
# ============================================================

@app.post("/api/route/cameras")
def get_route_cameras(
    body: dict = Body(...)
):

    conn = None
    cursor = None

    try:

        route_geometry = body.get(
            "route_geometry"
        )

        radius_meters = body.get(
            "camera_radius_meters",
            DEFAULT_CAMERA_ROUTE_RADIUS_METERS
        )

        if not route_geometry:

            raise HTTPException(
                status_code=400,
                detail=(
                    "route_geometry is required"
                )
            )

        try:

            radius_meters = float(
                radius_meters
            )

        except (
            TypeError,
            ValueError
        ):

            raise HTTPException(
                status_code=400,
                detail=(
                    "camera_radius_meters "
                    "must be numeric"
                )
            )

        if radius_meters <= 0:

            raise HTTPException(
                status_code=400,
                detail=(
                    "camera_radius_meters "
                    "must be greater than 0"
                )
            )

        if radius_meters > MAX_CAMERA_ROUTE_RADIUS_METERS:

            raise HTTPException(
                status_code=400,
                detail=(
                    "camera_radius_meters cannot "
                    f"exceed {MAX_CAMERA_ROUTE_RADIUS_METERS} "
                    "meters"
                )
            )

        route_geometry_json = json.dumps(
            route_geometry
        )

        conn = get_db_connection()

        cursor = conn.cursor(
            cursor_factory=RealDictCursor
        )

        cursor.execute(
            """
            WITH route AS
            (
                SELECT
                    ST_SetSRID(
                        ST_GeomFromGeoJSON(%s),
                        4326
                    ) AS geom
            )

            SELECT

                c.id,

                c.latitude,

                c.longitude,

                c.country,

                c.state,

                c.city,

                c.road_name,

                c.camera_type,

                c.speed_limit,

                c.status,

                c.verification_status,

                ST_Distance(
                    c.location,
                    route.geom::geography
                ) AS distance_from_route_meters

            FROM cameras c

            CROSS JOIN route

            WHERE
                ST_DWithin(
                    c.location,
                    route.geom::geography,
                    %s
                )

            ORDER BY
                distance_from_route_meters ASC

            """,
            (
                route_geometry_json,
                radius_meters
            )
        )

        cameras = cursor.fetchall()

        result = []

        for camera in cameras:

            camera_data = dict(camera)

            distance = float(
                camera_data.get(
                    "distance_from_route_meters",
                    0
                )
                or 0
            )

            camera_data[
                "distance_from_route_meters"
            ] = round(
                distance,
                2
            )

            camera_data[
                "distance_from_route_km"
            ] = round(
                distance / 1000,
                3
            )

            result.append(
                camera_data
            )

        return {

            "success": True,

            "radius_meters": radius_meters,

            "total_cameras": len(result),

            "cameras": result

        }

    except HTTPException:

        raise

    except Exception as e:

        logger.exception(
            "Route camera search failed"
        )

        raise HTTPException(
            status_code=500,
            detail=str(e)
        )

    finally:

        if cursor:

            try:
                cursor.close()
            except Exception:
                pass

        if conn:

            try:
                conn.close()
            except Exception:
                pass


