@app.put("/api/reports/{report_id}/approve")
def approve_report(
    report_id: int
):

    conn = None
    cursor = None

    try:

        conn = get_db_connection()

        cursor = conn.cursor(
            cursor_factory=RealDictCursor
        )

        # ----------------------------------------------------
        # GET REPORT
        # ----------------------------------------------------

        cursor.execute(
            """
            SELECT
                id,
                latitude,
                longitude,
                city,
                state,
                road_name,
                camera_type,
                reporter_name,
                notes,
                status,
                created_at,
                image_path
            FROM camera_reports
            WHERE id = %s
            FOR UPDATE
            """,
            (report_id,)
        )

        report = cursor.fetchone()

        if report is None:

            raise HTTPException(
                status_code=404,
                detail="Report not found"
            )

        # ----------------------------------------------------
        # PREVENT DUPLICATE APPROVAL
        # ----------------------------------------------------

        if str(
            report["status"]
        ).strip().lower() == "approved":

            raise HTTPException(
                status_code=400,
                detail=(
                    "Report has already "
                    "been approved"
                )
            )

        # ----------------------------------------------------
        # VALIDATE LATITUDE
        # ----------------------------------------------------

        if report["latitude"] is None:

            raise HTTPException(
                status_code=400,
                detail="Report latitude is missing"
            )

        try:

            latitude = float(
                report["latitude"]
            )

        except (TypeError, ValueError):

            raise HTTPException(
                status_code=400,
                detail="Invalid report latitude"
            )

        if not -90 <= latitude <= 90:

            raise HTTPException(
                status_code=400,
                detail="Invalid report latitude"
            )

        # ----------------------------------------------------
        # VALIDATE LONGITUDE
        # ----------------------------------------------------

        if report["longitude"] is None:

            raise HTTPException(
                status_code=400,
                detail="Report longitude is missing"
            )

        try:

            longitude = float(
                report["longitude"]
            )

        except (TypeError, ValueError):

            raise HTTPException(
                status_code=400,
                detail="Invalid report longitude"
            )

        if not -180 <= longitude <= 180:

            raise HTTPException(
                status_code=400,
                detail="Invalid report longitude"
            )

        # ----------------------------------------------------
        # CHECK DUPLICATE CAMERA
        # ----------------------------------------------------

        cursor.execute(
            """
            SELECT
                id,
                latitude,
                longitude,
                country,
                state,
                city,
                road_name,
                camera_type,
                status,
                verification_status
            FROM cameras
            WHERE latitude = %s
              AND longitude = %s
            LIMIT 1
            """,
            (
                latitude,
                longitude
            )
        )

        existing_camera = cursor.fetchone()

        if existing_camera is not None:

            raise HTTPException(
                status_code=409,
                detail={
                    "message": (
                        "Cannot approve report. "
                        "A camera already exists "
                        "at these coordinates."
                    ),
                    "existing_camera": dict(
                        existing_camera
                    )
                }
            )

        # ----------------------------------------------------
        # INSERT CAMERA
        # ----------------------------------------------------

        camera_insert_sql = """
            INSERT INTO cameras
            (
                country,
                state,
                city,
                location,
                road_name,
                latitude,
                longitude,
                camera_type,
                status,
                verification_status
            )
            VALUES
            (
                'India',
                %s,
                %s,
                ST_SetSRID(
                    ST_MakePoint(%s, %s),
                    4326
                )::geography,
                %s,
                %s,
                %s,
                %s,
                'Active',
                'Verified'
            )
            RETURNING *
        """

        camera_parameters = (
            report["state"],
            report["city"],
            longitude,
            latitude,
            report["road_name"],
            latitude,
            longitude,
            report["camera_type"]
        )

        cursor.execute(
            camera_insert_sql,
            camera_parameters
        )

        camera = cursor.fetchone()

        if camera is None:

            raise HTTPException(
                status_code=500,
                detail="Camera was not created"
            )

        # ----------------------------------------------------
        # UPDATE REPORT
        # ----------------------------------------------------

        cursor.execute(
            """
            UPDATE camera_reports
            SET status = 'Approved'
            WHERE id = %s
            RETURNING *
            """,
            (report_id,)
        )

        updated_report = cursor.fetchone()

        if updated_report is None:

            raise HTTPException(
                status_code=500,
                detail=(
                    "Report status could "
                    "not be updated"
                )
            )

        # ----------------------------------------------------
        # COMMIT
        # ----------------------------------------------------

        conn.commit()

        logger.info(
            "Report %s approved successfully. "
            "Camera %s created.",
            report_id,
            camera["id"]
        )

        return {
            "message": (
                "Report approved successfully"
            ),
            "report": dict(updated_report),
            "camera": dict(camera)
        }

    except HTTPException:

        if conn:

            try:
                conn.rollback()
            except Exception:
                pass

        raise

    except psycopg2.Error as e:

        if conn:

            try:
                conn.rollback()
            except Exception:
                pass

        logger.error(
            "Database error while approving "
            "report %s: %s",
            report_id,
            str(e)
        )

        raise HTTPException(
            status_code=500,
            detail={
                "message": (
                    "Database error while "
                    "approving report"
                ),
                "error": str(e)
            }
        )

    except Exception as e:

        if conn:

            try:
                conn.rollback()
            except Exception:
                pass

        logger.exception(
            "Unexpected error approving "
            "report %s",
            report_id
        )

        raise HTTPException(
            status_code=500,
            detail=str(e)
        )

    finally:

        if cursor:

            try:
                cursor.close()
            except Exception:
                pass

        if conn:

            try:
                conn.close()
            except Exception:
                pass


