@app.get("/api/cameras/search")
def search_cameras(
    q: str = Query(
        ...,
        min_length=1
    )
):

    conn = None
    cursor = None

    try:

        conn = get_db_connection()

        cursor = conn.cursor(
            cursor_factory=RealDictCursor
        )

        search_term = (
            f"%{q.strip()}%"
        )

        cursor.execute(
            """
            SELECT *
            FROM cameras
            WHERE
                CAST(id AS TEXT) ILIKE %s
                OR COALESCE(city, '') ILIKE %s
                OR COALESCE(state, '') ILIKE %s
                OR COALESCE(road_name, '') ILIKE %s
                OR COALESCE(camera_type, '') ILIKE %s
            ORDER BY id DESC
            """,
            (
                search_term,
                search_term,
                search_term,
                search_term,
                search_term
            )
        )

        cameras = cursor.fetchall()

        return [
            dict(camera)
            for camera in cameras
        ]

    except Exception as e:

        logger.error(
            "Camera search failed: %s",
            str(e)
        )

        raise HTTPException(
            status_code=500,
            detail="Camera search failed"
        )

    finally:

        if cursor:

            try:
                cursor.close()
            except Exception:
                pass

        if conn:

            try:
                conn.close()
            except Exception:
                pass



# ============================================================
# CAMERAS NEARBY + AHEAD OF USER
# ============================================================
@app.get("/api/cameras/nearby")
def get_nearby_cameras(
    latitude: float = Query(...),
    longitude: float = Query(...),
    bearing: float = Query(...),
    radius_meters: float = Query(1000),
):
    """Return cameras within the search radius that are ahead of the user."""

    conn = None
    cursor = None

    try:
        latitude = float(latitude)
        longitude = float(longitude)
        bearing = float(bearing) % 360
        radius_meters = float(radius_meters)

        # Validate numeric inputs.
        if not math.isfinite(latitude):
            raise HTTPException(
                status_code=400,
                detail="latitude must be a finite number",
            )

        if not math.isfinite(longitude):
            raise HTTPException(
                status_code=400,
                detail="longitude must be a finite number",
            )

        if not math.isfinite(bearing):
            raise HTTPException(
                status_code=400,
                detail="bearing must be a finite number",
            )

        if not math.isfinite(radius_meters):
            raise HTTPException(
                status_code=400,
                detail="radius_meters must be a finite number",
            )

        if not -90 <= latitude <= 90:
            raise HTTPException(
                status_code=400,
                detail="Invalid latitude",
            )

        if not -180 <= longitude <= 180:
            raise HTTPException(
                status_code=400,
                detail="Invalid longitude",
            )

        if radius_meters <= 0:
            raise HTTPException(
                status_code=400,
                detail="radius_meters must be greater than 0",
            )

        if radius_meters > 5000:
            raise HTTPException(
                status_code=400,
                detail="radius_meters cannot exceed 5000 meters",
            )

        conn = get_db_connection()
        cursor = conn.cursor(cursor_factory=RealDictCursor)

        cursor.execute(
            """
            WITH user_point AS (
                SELECT ST_SetSRID(
                    ST_MakePoint(%s, %s),
                    4326
                ) AS geom
            ),
            nearby AS (
                SELECT
                    c.id,
                    ST_Y(c.location::geometry) AS latitude,
                    ST_X(c.location::geometry) AS longitude,
                    c.country,
                    c.city,
                    c.camera_type,
                    c.speed_limit,
                    c.status,
                    c.verification_status,
                    c.source,
                    c.created_at,
                    c.updated_at,
                    c.state,
                    c.road_name,
                    c.enforcement_type,
                    c.source_url,
                    c.last_verified,
                    c.reported_by,
                    c.image_url,
                    c.report_date,
                    c.camera_uuid,
                    c.road_direction,
                    c.travel_direction,
                    c.lane_number,
                    c.installation_date,
                    c.operational_status,
                    c.owning_agency,
                    c.district,
                    c.postal_code,
                    c.address,
                    c.confidence_score,
                    c.is_active,
                    c.updated_by,
                    c.notes,
                    c.agency_id,

                    ST_Distance(
                        c.location,
                        u.geom::geography
                    ) AS distance_meters,

                   DEGREES(
    ST_Azimuth(
        u.geom,
        c.location::geometry
    )
) AS camera_bearing

                FROM cameras c
                CROSS JOIN user_point u

                WHERE ST_DWithin(
                    c.location,
                    u.geom::geography,
                    %s
                )
            ),
            calculated AS (
                SELECT
                    nearby.*,

                    ABS(
                        MOD(
                            (
                                camera_bearing - %s + 540
                            )::numeric,
                            360::numeric
                        ) - 180
                    ) AS bearing_difference

                FROM nearby
            )

            SELECT *
            FROM calculated

            WHERE bearing_difference <= 90

            ORDER BY
                distance_meters ASC,
                bearing_difference ASC,
                id ASC
            """,
            (
                longitude,
                latitude,
                radius_meters,
                bearing,
            ),
        )

        rows = cursor.fetchall()
        cameras = []

        for row in rows:
            camera = dict(row)

            # Convert PostGIS numeric values into JSON-safe numbers.
            if camera.get("latitude") is not None:
                camera["latitude"] = round(
                    float(camera["latitude"]),
                    7,
                )

            if camera.get("longitude") is not None:
                camera["longitude"] = round(
                    float(camera["longitude"]),
                    7,
                )

            if camera.get("distance_meters") is not None:
                camera["distance_meters"] = round(
                    float(camera["distance_meters"]),
                    2,
                )

            if camera.get("camera_bearing") is not None:
                camera["camera_bearing"] = round(
                    float(camera["camera_bearing"]) % 360,
                    2,
                )

            if camera.get("bearing_difference") is not None:
                camera["bearing_difference"] = round(
                    float(camera["bearing_difference"]),
                    2,
                )

            distance = float(
                camera.get("distance_meters") or 0
            )

            # Navigation warning thresholds.
            if distance <= 10:
                warning_level = "10m"
            elif distance <= 50:
                warning_level = "50m"
            elif distance <= 100:
                warning_level = "100m"
            elif distance <= 200:
                warning_level = "200m"
            elif distance <= 500:
                warning_level = "500m"
            elif distance <= 1000:
                warning_level = "1000m"
            else:
                warning_level = None

            camera["warning_level"] = warning_level

            if distance < 1000:
                camera["distance_text"] = f"{round(distance)} m"
            else:
                camera["distance_text"] = (
                    f"{distance / 1000:.2f} km"
                )

            cameras.append(camera)

        return {
            "success": True,
            "user": {
                "latitude": latitude,
                "longitude": longitude,
                "bearing": round(bearing, 2),
                "radius_meters": radius_meters,
            },
            "total_cameras": len(cameras),
            "next_camera": cameras[0] if cameras else None,
            "cameras": cameras,
        }

    except HTTPException:
        raise

    except psycopg2.Error as e:
        logger.error(
            "Nearby camera database error: %s",
            str(e),
        )

        raise HTTPException(
            status_code=500,
            detail={
                "message": (
                    "Database error while finding "
                    "nearby cameras"
                ),
                "error": str(e),
            },
        )

    except Exception as e:
        logger.exception(
            "Nearby camera search failed"
        )

        raise HTTPException(
            status_code=500,
            detail=str(e),
        )

    finally:
        if cursor:
            try:
                cursor.close()
            except Exception:
                pass

        if conn:
            try:
                conn.close()
            except Exception:
                pass
