# CREATE CAMERA
# ============================================================

@app.post("/api/cameras")
def create_camera(
    body: dict = Body(...)
):

    conn = None
    cursor = None

    try:

        latitude = body.get("latitude")
        longitude = body.get("longitude")

        country = body.get(
            "country",
            "India"
        )

        state = body.get("state")
        city = body.get("city")
        road_name = body.get("road_name")
        camera_type = body.get("camera_type")
        speed_limit = body.get("speed_limit")

        status = body.get(
            "status",
            "Active"
        )

        verification_status = body.get(
            "verification_status",
            "Verified"
        )

        source = body.get("source")
        source_url = body.get("source_url")

        # ----------------------------------------------------
        # VALIDATE COORDINATES
        # ----------------------------------------------------

        if latitude is None:

            raise HTTPException(
                status_code=400,
                detail="Latitude is required"
            )

        if longitude is None:

            raise HTTPException(
                status_code=400,
                detail="Longitude is required"
            )

        try:

            latitude = float(latitude)
            longitude = float(longitude)

        except (TypeError, ValueError):

            raise HTTPException(
                status_code=400,
                detail=(
                    "Latitude and longitude "
                    "must be numeric"
                )
            )

        if not -90 <= latitude <= 90:

            raise HTTPException(
                status_code=400,
                detail="Invalid latitude"
            )

        if not -180 <= longitude <= 180:

            raise HTTPException(
                status_code=400,
                detail="Invalid longitude"
            )

        # ----------------------------------------------------
        # DATABASE
        # ----------------------------------------------------

        conn = get_db_connection()

        cursor = conn.cursor(
            cursor_factory=RealDictCursor
        )

        # ----------------------------------------------------
        # CHECK DUPLICATE CAMERA
        # ----------------------------------------------------

        cursor.execute(
            """
            SELECT
                id,
                latitude,
                longitude,
                country,
                state,
                city,
                road_name,
                camera_type,
                status,
                verification_status
            FROM cameras
            WHERE latitude = %s
              AND longitude = %s
            LIMIT 1
            """,
            (
                latitude,
                longitude
            )
        )

        existing_camera = cursor.fetchone()

        if existing_camera is not None:

            raise HTTPException(
                status_code=409,
                detail={
                    "message": (
                        "Duplicate camera detected. "
                        "A camera already exists at "
                        "these coordinates."
                    ),
                    "existing_camera": dict(
                        existing_camera
                    )
                }
            )

        # ----------------------------------------------------
        # INSERT CAMERA
        # ----------------------------------------------------

        cursor.execute(
            """
            INSERT INTO cameras
            (
                country,
                state,
                city,
                location,
                road_name,
                latitude,
                longitude,
                camera_type,
                speed_limit,
                status,
                verification_status,
                source,
                source_url
            )
            VALUES
            (
                %s,
                %s,
                %s,
                ST_SetSRID(
                    ST_MakePoint(%s, %s),
                    4326
                )::geography,
                %s,
                %s,
                %s,
                %s,
                %s,
                %s,
                %s,
                %s,
                %s
            )
            RETURNING *
            """,
            (
                country,
                state,
                city,
                longitude,
                latitude,
                road_name,
                latitude,
                longitude,
                camera_type,
                speed_limit,
                status,
                verification_status,
                source,
                source_url
            )
        )

        camera = cursor.fetchone()

        conn.commit()

        return {
            "message": "Camera created successfully",
            "camera": dict(camera)
        }

    except HTTPException:

        if conn:

            try:
                conn.rollback()
            except Exception:
                pass

        raise

    except Exception as e:

        if conn:

            try:
                conn.rollback()
            except Exception:
                pass

        logger.error(
            "POST /api/cameras failed: %s",
            str(e)
        )

        raise HTTPException(
            status_code=500,
            detail=str(e)
        )

    finally:

        if cursor:

            try:
                cursor.close()
            except Exception:
                pass

        if conn:

            try:
                conn.close()
            except Exception:
                pass


